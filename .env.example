# QuantFlow local secrets template
# Copy to .env and fill values locally. Do not commit .env.

# Preferred explicit proxy variable used by QuantFlow Finviz client.
QF_SCRAPING_PROXY_URL=http://user:pass@proxy.host:3128

# Compatibility alias (already supported):
# SENSITIVE_LOOKUP_PROXY_URL=http://user:pass@proxy.host:3128

# Optional provider hint (used for diagnostics): smartproxy | scrape_do | scrapingbee
QF_SCRAPING_PROVIDER=smartproxy

# Optional API-key providers for other scraping paths.
SCRAPING_API_KEY=replace_with_scrape_do_or_other_key
SCRAPINGBEE_API_KEY=replace_with_scrapingbee_key

# Optional API endpoints (only used in API mode when proxy URL is not set)
SCRAPE_DO_ENDPOINT=https://api.scrape.do
SCRAPINGBEE_ENDPOINT=https://app.scrapingbee.com/api/v1/

# Optional API auth settings
# Set to true to require auth for mutating endpoints.
QF_API_AUTH_ENABLED=false

# Token auth mode (if enabled and firebase disabled)
QF_API_TOKEN=replace_with_local_dev_token

# Firebase/Google auth mode
QF_FIREBASE_AUTH_ENABLED=false
# Path to Firebase service account JSON for backend token verification and Firestore access.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Optional Firebase write-authorization claims
QF_FIREBASE_WRITE_CLAIM=quantflow_write
QF_FIREBASE_WRITE_ROLES=writer,admin

# Optional ScrapingBee knobs (API mode)
SCRAPINGBEE_RENDER_JS=false
# SCRAPINGBEE_COUNTRY_CODE=us
# SCRAPINGBEE_PREMIUM_PROXY=true

# Alpaca Markets — paper trading API (free)
# Get keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PK_...
ALPACA_SECRET_KEY=...
